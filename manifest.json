{
  "manifest_version": 3,
  "name": "Lector local para Edge",
  "version": "0.5.0",
  "description": "Lee texto y documentos con síntesis de voz procesada localmente.",
  "action": { "default_title": "Abrir lector local" },
  "side_panel": { "default_path": "dist/sidepanel.html" },
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "permissions": ["storage", "sidePanel", "offscreen", "activeTab", "scripting", "contextMenus"],
  "host_permissions": [
    "file:///*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://cdn-lfs.huggingface.co/*",
    "https://*.xethub.hf.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
