{
  "manifest_version": 3,
  "name": "Lector local para Edge",
  "version": "0.2.0",
  "description": "Lee texto y documentos con síntesis de voz procesada localmente.",
  "action": { "default_title": "Abrir lector", "default_popup": "dist/popup.html" },
  "permissions": ["storage"],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://cdn-lfs.huggingface.co/*",
    "https://*.xethub.hf.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
