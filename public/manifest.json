{
  "manifest_version": 3,
  "name": "eTTS Reader",
  "version": "0.5.0",
  "description": "Lee texto y documentos con Kokoro inglés y Piper español, de forma local.",
  "action": {
    "default_title": "Abrir eTTS Reader",
    "default_icon": {
      "16": "icons/etts-16.png",
      "32": "icons/etts-32.png",
      "48": "icons/etts-48.png",
      "128": "icons/etts-128.png"
    }
  },
  "icons": {
    "16": "icons/etts-16.png",
    "32": "icons/etts-32.png",
    "48": "icons/etts-48.png",
    "128": "icons/etts-128.png"
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "sidePanel", "offscreen", "activeTab", "scripting", "contextMenus"],
  "optional_permissions": ["tabs"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": [
    "file:///*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://cdn-lfs.huggingface.co/*",
    "https://*.xethub.hf.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
